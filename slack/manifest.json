{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Northbridge Demo",
    "description": "Creates the Northbridge University workspace, invites Maya, Leah, and Helen, and posts the webinar lines.",
    "background_color": "#0f5f5b"
  },
  "features": {
    "bot_user": {
      "display_name": "Northbridge Demo",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:manage",
        "channels:write",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "team:read",
        "users:read"
      ],
      "user": [
        "admin.teams:write",
        "admin.users:write",
        "channels:write",
        "chat:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
